generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
        
// Enum for lead source tracking
enum LeadSource {
  MANUAL
  RANDOM_USER_API
}

// Main Lead model
model Lead {
  id          String      @id @default(uuid())
  
  // Source tracking
  source      LeadSource
  externalId  String?     @unique  // For avoiding duplicates from RandomUser API
  
  // Basic info
  firstName   String
  lastName    String
  email       String      @unique
  phone       String?
  
  // Address
  street      String?
  city        String?
  state       String?
  country     String?
  postcode    String?
  
  // Additional info
  gender      String?
  dateOfBirth DateTime?
  picture     String?     // URL to profile picture
  
  // AI-generated fields
  aiSummary   String?
  nextAction  String?
  
  // Timestamps
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leads")
}

// Sync log for tracking API sync operations
model SyncLog {
  id           String   @id @default(uuid())
  
  syncedAt     DateTime @default(now())  // When the sync happened
  leadsCount   Int                        // How many leads were synced in this batch
  success      Boolean  @default(true)    // Whether the sync was successful
  errorMessage String?                    // Error message if sync failed
  
  @@map("sync_logs")
}
